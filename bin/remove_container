#!/bin/bash

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
source ${DIR}/find_default_container_file.inc

container_name=$(parseContainerArgs $*)
if [ -z "${container_name}" ]; then
    exit 1
fi

container_id=$(${DOCKER_BINARY} ps -q -f "status=running" -f "name=$container_name")

if [ -n "${container_id}" ]; then
    ${DOCKER_BINARY} stop ${container_name}
fi

${DOCKER_BINARY} rm ${container_name}
rm $DIR/../.container_name

spawn_clone_image_name=$(${DOCKER_BINARY} image ls -q -f "reference=$container_name:clone-spawn")

if [ -n "${spawn_clone_image_name}" ]; then 
    echo Removing spawn image $spawn_clone_image_name
    ${DOCKER_BINARY} image rm $spawn_clone_image_name
fi 
