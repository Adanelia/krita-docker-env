#!/bin/bash

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

ROOT_DIR="$(realpath $DIR/../)"

CLONES_ARRAY=()

while [[ $# -gt 0 ]]; do
    CLONES_ARRAY+=("$1")
    shift
done

for CLONE_DIR in "${CLONES_ARRAY[@]}"; do
    echo Removing clone $CLONE_DIR...
    
    if [ ! -d $CLONE_DIR ]; then
        echo "Clone \"$CLONE_DIR\" does not exist"
        exit 1
    fi

    if [ ! -f $CLONE_DIR/.container_name ]; then
        echo "Container file \"$CLONE_DIR/.container_name\" is not found"
        exit 2
    fi

    (
        cd $CLONE_DIR
        ./bin/remove_container
    )

    rm -rf $CLONE_DIR
    
done

