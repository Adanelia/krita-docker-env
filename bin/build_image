#!/bin/bash

usage=\
"Usage: $(basename "$0") [OPTION]... [IMAGE_NAME]\n
Build an image for the container\n
\n
where:\n
    -h,      --help              show this help text\n
    -s,     --skip-deps          skip unpacking deps\n
\n
If no IMAGE_NAME is given, it is deduced from the\n 
current directory name    
"

DEPS_EXTRA_ARGS=

# Call getopt to validate the provided input. 
options=$(getopt -o sh --long skip-deps,help -- "$@")
[ $? -eq 0 ] || { 
    echo "Incorrect options provided"
    exit 1
}
eval set -- "$options"
while true; do
    case "$1" in
    -s | --skip-deps)
        DEPS_EXTRA_ARGS="--target=base_image"
        ;;
    -h | --help)
        echo -e $usage >&2
        exit 1
        ;;
    --)
        shift
        break
        ;;
    esac
    shift
done

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
source ${DIR}/find_default_container_file.inc

IMAGE_NAME=${@:$OPTIND:1}

if [[ -z ${IMAGE_NAME} ]]; then
    IMAGE_NAME=$(basename $(realpath $DIR/..))
    echo Auto-select image name: ${IMAGE_NAME}
fi

${DOCKER_BINARY} build -t $IMAGE_NAME . ${DEPS_EXTRA_ARGS}
